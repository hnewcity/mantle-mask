# Bind to 0.0.0.0 only when exposing the service intentionally.
MANTLE_ADDR=127.0.0.1:8080
MANTLE_DATA_DIR=./data
# Optional. Otherwise a random token is created in data/admin-token.
MANTLE_ADMIN_TOKEN=
# Optional base64-encoded 32-byte encryption key. Otherwise data/master.key is used.
MANTLE_MASTER_KEY=
# Exact allowed browser origins, comma-separated. Same-origin UI needs no CORS.
MANTLE_CORS_ORIGINS=
# SigV4 default credential chain: environment, shared config, ECS/EC2 roles.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional Compose image override; pin a version for production.
# MANTLE_IMAGE=ghcr.io/hnewcity/mantle-mask:0.2.0
